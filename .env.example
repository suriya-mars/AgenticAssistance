# Copy to .env and adjust. ./agent reads it on every run.

# Model roles (both models are inside the image):
#   fast = routing, mail triage, reply classification
#   main = ASoC analysis, PDF and bug Q&A, drafting, QC analysis
AGENT_MODEL_FAST=qwen3:4b
# Empty = automatic: qwen3.5:9b when a GPU is available, qwen3:4b on CPU-only machines.
# qwen3.5:9b on CPU works but is ~2-3x slower; set it explicitly if you want it anyway.
AGENT_MODEL_MAIN=

# Empty = automatic: 1 with a GPU, 4 on CPU-only (longer time limits for the models)
AGENT_TIMEOUT_SCALE=

# Reasoning mode: false is much faster for the structured outputs this app uses
AGENT_OLLAMA_THINK=false

# IMAP app password (when config/settings.yaml has mail.source: imap)
AGENT_IMAP_PASSWORD=

# Force CPU (0) or GPU (1). Empty = auto-detect.
AGENT_GPU=
